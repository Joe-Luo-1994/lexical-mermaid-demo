{
  "name": "editor-evidence-lab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:rules && npm run build && npm run test:browser",
    "bench": "node scripts/bench.mjs",
    "validate": "node scripts/validate-fixtures.mjs",
    "test:rules": "node --test scripts/diagnostics.test.mjs scripts/report-query.test.mjs",
    "test:browser": "node scripts/verify-evidence.mjs",
    "test:legacy": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@lexical/code": "0.18.0",
    "@lexical/headless": "0.18.0",
    "@lexical/link": "0.18.0",
    "@lexical/list": "0.18.0",
    "@lexical/react": "0.18.0",
    "@lexical/rich-text": "0.18.0",
    "@lexical/table": "0.18.0",
    "lexical": "0.18.0",
    "mermaid": "12.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "jsdom": "31.0.0",
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
